{
  "name": "tarabao-up-to-date-front-end",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tarabao Designsystem und vollständige Komponenten-Bibliothek auf Basis von shadcn/ui, kompatibel mit apps/medusa-storefront",
  "keywords": [
    "medusa-storefront",
    "design-system",
    "shadcn"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "eslint .",
    "tsc": "tsc --noEmit",
    "test": "vitest run src",
    "test:ui": "vitest --ui src",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:styles": "node scripts/check-styles.mjs",
    "check": "pnpm tsc && pnpm lint && pnpm check:styles && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:foundations": "node scripts/gen-foundations.mjs",
    "gen:mapping": "node scripts/gen-mapping.mjs"
  },
  "dependencies": {
    "@lingui/core": "^5.9.0",
    "@lingui/react": "^5.9.0",
    "@medusajs/js-sdk": "2.17.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@lingui/cli": "^5.9.0",
    "@lingui/format-po": "^6.0.1",
    "@lingui/loader": "^5.9.5",
    "@lingui/macro": "^5.9.0",
    "@lingui/swc-plugin": "5.10.1",
    "@medusajs/types": "2.17.2",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "@storybook/nextjs-vite": "^10.0.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.x",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.1",
    "ansi-colors": "^4.1.3",
    "eslint": "9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.2.5",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "storybook": "^10.0.8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
